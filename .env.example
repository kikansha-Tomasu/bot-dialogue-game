# Bot対話ゲーム 環境変数テンプレート
# このファイルをコピーして `.env` を作成し、必要な値を設定してください。
# 既定では有料枠・API課金が一切不要な自然・高性能ローカル Hugging Face AI モードで動作します。

# ローカル Hugging Face GGUF 自然高性能LLMモデル（完全無料・トークン不要で動作）
HF_USE_CLOUD_ROUTER=false
HF_GEMMA3_GGUF_REPO=unsloth/gemma-3-4b-it-GGUF
HF_SARASHINA_GGUF_REPO=mmnga/sarashina2.2-3b-instruct-v0.1-gguf
HF_TINYSWALLOW_GGUF_REPO=SakanaAI/TinySwallow-1.5B-Instruct-GGUF
HF_LOCAL_MODEL=unsloth/gemma-3-4b-it-GGUF
HF_DEFAULT_MODEL=unsloth/gemma-3-4b-it-GGUF

# Hugging Face 自然日本語音声合成モデル（Style-Bert-VITS2 JP-Extra、完全無料）
HF_TTS_REPO=litagin/style_bert_vits2_jvnv
HF_BERT_REPO=ku-nlp/deberta-v2-large-japanese-char-wwm
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# （任意）クラウドの Hugging Face Router API を使う場合のみ設定
# HF_TOKEN=

# ゲームサーバー待受設定
GAME_HOST=127.0.0.1
GAME_PORT=8765
